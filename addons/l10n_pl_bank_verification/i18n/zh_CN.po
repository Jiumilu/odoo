#. module: l10n_pl_bank_verification
# Auto-completed for GlobalCloud GPC zh_CN coverage.
#: model:ir.model.fields,help:l10n_pl_bank_verification.field_account_payment__l10n_pl_verification_status
#: model:ir.model.fields,help:l10n_pl_bank_verification.field_l10n_pl_bank_account_verification__verification_status
msgid ""
"Flag the payment verification status with one of the following:\n"
"- Valid: The partner VAT is linked to the bank account used for this payment.\n"
"- Invalid: The partner VAT is not linked to the bank account used for this payment.\n"
"- Incomplete partner: The partner has no VAT or no bank account.\n"
"- Partner not found: Partner VAT not found in Government files.\n"
"- Error: An error occurred during check with Government API.\n"
msgstr ""
"Flag the 付款 verification 状态 with one of the following: - 有效: The 业务伙伴 VAT is"
" linked to the 银行账户 used for this 付款. - 无效: The 业务伙伴 VAT is not linked to "
"the 银行账户 used for this 付款. - Incomplete 业务伙伴: The 业务伙伴 has 否 VAT or 否 银行账户. "
"- 业务伙伴 not found: 业务伙伴 VAT not found in Government files. - 错误: An 错误 "
"occurred during 检查 with Government API.\n"

