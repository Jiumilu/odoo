[options]
; Copy this file to a private path such as .runtime/gpc-odoo.conf.
; Do not commit real passwords.

addons_path = /absolute/path/to/GlobalCloud GPC/addons
data_dir = /absolute/path/to/odoo-data

db_host = 127.0.0.1
db_port = 54329
db_user = odoo
db_password = CHANGE_ME_STRONG_DATABASE_PASSWORD
db_name = GCGPC
list_db = False

admin_passwd = CHANGE_ME_STRONG_MASTER_PASSWORD
http_interface = 127.0.0.1
http_port = 8069
proxy_mode = False

; For a reverse-proxied server, set proxy_mode=True and configure the proxy
; to forward HTTPS and websocket traffic correctly. Enable workers only after
; validating worker stability in the target host.
workers = 0
max_cron_threads = 1
limit_time_cpu = 60
limit_time_real = 120
log_level = info
