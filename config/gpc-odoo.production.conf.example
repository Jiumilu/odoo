[options]
; Copy this file to a private path such as .runtime/gpc-odoo.conf.
; Do not commit real passwords.

addons_path = /absolute/path/to/GlobalCloud GPC/addons
data_dir = /absolute/path/to/odoo-data

db_host = 127.0.0.1
db_port = 54329
db_user = odoo
db_password = CHANGE_ME_STRONG_DATABASE_PASSWORD
db_name = GCGPC
list_db = False

admin_passwd = CHANGE_ME_STRONG_MASTER_PASSWORD
http_interface = 127.0.0.1
http_port = 8070
gevent_port = 8072
proxy_mode = True

; Run the public reverse proxy on 8069. Route ordinary HTTP traffic to
; http_port and route /websocket to gevent_port.
workers = 2
max_cron_threads = 1
limit_time_cpu = 60
limit_time_real = 120
log_level = info
